{
  "name": "aventra",
  "version": "0.1.0",
  "private": true,
  "description": "AVENTRA Telegram-based cryptocurrency trading platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "admin:bootstrap": "tsx src/users/bootstrap-admin-cli.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "grammy": "^1.35.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2",
    "pg": "^8.13.3",
    "@fastify/rate-limit": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.4",
    "@types/pg": "^8.11.11"
  }
}
